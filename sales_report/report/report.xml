<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="paperformat_warning_letter" model="report.paperformat">
		<field name="name">European A4 HR Clearance Letter</field>
		<field name="default" eval="True"/>
	  <field name="format">A4</field>
	  <field name="page_height">0</field>
	  <field name="page_width">0</field>
	  <field name="orientation">Portrait</field>
	  <field name="margin_top">50</field>
	  <field name="margin_bottom">3</field>
	  <field name="margin_left">3</field>
	  <field name="margin_right">3</field>
	  <field name="header_line" eval="False"/>
	  <field name="header_spacing">45</field>
	  <field name="dpi">90</field>
	</record>

	<record id="action_report_sale_order" model="ir.actions.report">
		<field name="name">Sale Order Template Report</field>
		<field name="model">sale.order</field>
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">sales_report.report_sale_order</field>
		<field name="report_file">sales_report.report_sale_order</field>
		<field name="binding_model_id" ref="sale.model_sale_order"/>
		<field name="paperformat_id" ref="sales_report.paperformat_warning_letter"/>
		<field name="binding_type">report</field>
	</record>

</odoo>