<?xml version="1.0" encoding="utf-8"?>
<odoo>
	
	<!--Custom layout for Invoice Report-->
	<template id="external_layout_sale_order_report">
		<style>
			* {
				font-family: "Times New Roman", Times, serif;
			}
		</style>		
		<t t-if="not o" t-set="o" t-value="doc"/>
		<t t-if="not company">
			<!-- Multicompany -->
			<t t-if="company_id">
				<t t-set="company" t-value="company_id"/></t>
			<t t-elif="o and 'company_id' in o">
				<t t-set="company" t-value="o.company_id.sudo()"/></t>
			<t t-else="else">
				<t t-set="company" t-value="res_company"/></t>
		</t>
		<t t-call="sales_report.external_layout_standard_custom_sale_order">
			<t t-raw="0"/>
		</t>
	</template>
	
	<template id="external_layout_standard_custom_sale_order">
		<style>
			* {
				font-family: "Times New Roman", Times, serif;
			}
		</style>
		<div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
			<div class="row">
				<div class="col-4" style="text-align:left;">
					<img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="width: 30%;" alt="Logo"/>
				</div>
				<div class="col-8" style="text-align:right;padding-top:40px;">
					<h2 style="white-space: nowrap;">SALES ORDER FORM</h2>
				</div>
			</div>
			<!-- code for degree in header -->
			<div class="row d-flex justify-content-between">
				<!--<div class="col-9"><div><strong class="h1-title">डॉ.&#160;शुभम शिंदे</strong></div><div>BAMS MD(Ayu)(Pune)</div><div>I-96574 A</div></div>-->
			</div>
		</div>
		<div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout"
			 t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
			 t-att-data-oe-lang="o and o.env.context.get('lang')">
			<t t-call="web.address_layout"/>
			<t t-raw="0"/>
		</div>
		<div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">
			<t t-if="not o" t-set="o" t-value="doc"/>
			<div class="last-page  text-muted oe_mt8 oe_mb8" style="font-size:15px;">
				<div class="row" style="padding-top:10px;">
					<div class="col-12" style="text-align:center">
						<p>For questions concerning this order, please contact
							<br/>
							<t t-esc="o.partner_id.name"/>, (321) 456-7890,
							<t t-esc="o.partner_id.email"/>
							<br/>
							www.yourwebaddress.com
						</p>
					</div>
				</div>
			</div>
		</div>
	</template>

	<template id="report_sale_order">
		<t t-call="web.html_container">
			<t t-foreach="docs" t-as="o">
				<t t-call="pways_purchase_consignment.external_header_qweb">
					<style>
						* {
							font-family: "Times New Roman", Times, serif;
						}
					</style>
					<div class="row">
						<div class="col-4"/>
						<div class="col-4" style="padding:10px;">
							<h2 style="white-space: nowrap;">SALES ORDER FORM</h2>
						</div>
						<div class="col-4"/>
					</div>
					<div class="page">
						<div class="row">
							<div class="col-6" style="padding:10px;">
								<div style="border-bottom:1px solid black;margin-right:10px;width:70%;">
									<span>BILL TO</span>
								</div>
								<div style="margin-right:10px;">
									<span t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;,&quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}"/>
								</div>
								<!-- <h2 style="white-space: nowrap;">SALES ORDER FORM</h2> -->
								<!-- <span t-field="o.company_id.name"/>
								<br/>
								<span t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;,&quot;fields&quot;:[&quot;address&quot;,&quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}"/> -->
							</div>
							<div class="col-3"/>
							<div class="col-3">
								<table class="table table-borderless">
									<tr>
										<th style="border-bottom: 1px solid black;">
											<span t-field="o.date_order" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/>
										</th>
									</tr>
									<tr>
										<th style="border-bottom: 1px solid black;">
											<span t-field="o.name"/>
										</th>
									</tr>
									<tr>
										<th style="border-bottom: 1px solid black;">
											<span t-field="o.name"/>
										</th>
									</tr>																		
								</table>
							</div>
						</div>
						<!-- <div class="row" style="padding-top:40px;">
							<div class="col-6" style="border-bottom:1px solid black;margin-right:10px;">
								<span>BILL TO</span>
							</div>
							<div class="col-6">
							</div>
						</div>
						<div class="row">
							<div class="col-7" style="margin-right:10px;">
								<span t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;,&quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}"/>
							</div>
							<div class="col-5" style="margin-left:10px;">
							</div>
						</div> -->
						<br/>
						<table class="table table-borderless" style="font-size: 13px;">
							<!-- <tr style="white-space: nowrap;">
								<th>P.O NO.</th>
								<th>SALES PERSON</th>
								<th style="width: 2%;" colspan="2"></th>
								<th>SHIP VIA</th>
								<th>SHIPPING DATE</th>
							</tr>
							<tr>
								<th style="border: 1px solid black;">
									<br/>
								</th>
								<th style="border: 1px solid black;"></th>
								<th></th>
								<th></th>
								<th style="border: 1px solid black;"></th>
								<th style="border: 1px solid black;"></th>
							</tr>
							<tr style="white-space: nowrap;">
								<th style="width: 20%;">SHIPPING METHOD</th>
								<th style="width: 30%;">SHIPPING TERMS</th>
								<th style="width: 2%;" colspan="2"></th>
								<th style="width: 24%;">PAYMENT</th>
								<th style="width: 24%;">DELIVERY DATE</th>
							</tr>
							<tr>
								<th style="border: 1px solid black;">
									<br/>
								</th>
								<th style="border: 1px solid black;"></th>
								<th colspan="2"></th>
								<th style="border: 1px solid black;"></th>
								<th style="border: 1px solid black;"></th>
							</tr> -->
							<tr style="text-align: center;">
								<th style="padding-top: 10px;">ITEM NO.</th>
								<th style="padding-top: 10px;">DESCRIPTION</th>
								<th style="padding-top: 10px;">QTY</th>
								<th style="padding-top: 10px;">VAT</th>
								<th style="padding-top: 10px;">UNIT PRICE</th>
								<th style="padding-top: 10px;">TOTAL</th>
							</tr>
							<tbody>
								<t t-set="count" t-value="0"/>
								<t t-set="range_line" t-value="10 - len(o.order_line)"/>
								<t t-foreach="o.order_line" t-as="line">
									<t t-set="count" t-value="count + 1"/>
									<tr style="font-size:12px;">
										<td style="text-align: center;border:1px solid black;width:8%;">
											<t t-esc="count"/>
										</td>
										<td style="text-align: center;border:1px solid black;width:37%;">
											<t t-esc="line.name"/>
										</td>
										<td style="text-align: center;border:1px solid black;">
											<t t-esc="line.product_uom_qty"/>
										</td>
										<t t-set="taxes" t-value="', '.join([((str(tax.amount) + '%') or tax.name) for tax in line.tax_id])"/>
										<td t-attf-class="text-center {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}" style="text-align: center;border:1px solid black;">
		                                    <span t-out="taxes"></span>
		                                </td>
										<td style="text-align: center;border:1px solid black;">
											<t t-esc="'{:,.2f}'.format(line.price_unit)"/>
										</td>
										<td style="text-align: center;border:1px solid black;">
											<t t-esc="'{:,.2f}'.format(line.price_subtotal)"/>
										</td>
									</tr>
								</t>
								<t t-foreach="range(range_line)" t-as="l">
									<tr>
										<td style="border:1px solid black;">
											<br/>
										</td>
										<td style="border:1px solid black;"></td>
										<td style="border:1px solid black;"></td>
										<td style="border:1px solid black;"></td>
										<td style="border:1px solid black;"></td>
										<td style="border:1px solid black;"></td>
									</tr>
								</t>
								<tr>
									<td colspan="4">Remark/Instruction</td>
									<td style="text-align:right;">
										<span style="font-size:12px;">
											<b>SUBTOTAL</b>
										</span>
									</td>
									<td style="border-bottom:1px solid black;">
										<b t-esc="'{:,.2f}'.format(o.amount_untaxed)"/>
									</td>
								</tr>
								<tr>
									<td colspan="4"></td>
									<td style="text-align:right;">
										<span style="font-size:12px;">
											<b>TOTAL VAT</b>
										</span>
									</td>
									<td style="border-bottom:1px solid black;">
										<b t-esc="'{:,.2f}'.format(o.amount_tax)"/>
									</td>
								</tr>
								<tr>
									<td colspan="4"></td>
									<td style="text-align:right;">
										<span style="font-size:12px;">
											<b>TOTAL AMOUNT</b>
										</span>
									</td>
									<td style="border-top:1px black;border-bottom:1px black;background-color:#A5A391;">
										<b t-field="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
									</td>
								</tr>
								<tr>
									<td colspan="4" rowspan="3">
										please make check payble to your company name
										<br/>
										<h3>THANK YOU</h3>
									</td>
									<td style="text-align:right;">
									</td>
									<td>
									</td>
								</tr>
								
							</tbody>
						</table>
					</div>
				</t>
			</t>
		</t>
	</template>

</odoo>