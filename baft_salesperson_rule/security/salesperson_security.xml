<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Group for restricted access salespersons -->
    <record id="group_restricted_salesperson" model="res.groups">
        <field name="name">Restricted Salesperson</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <!-- Allow restricted salespersons to read their own user data -->
    <record id="res_users_rule_restricted_salesperson" model="ir.rule">
        <field name="name">User: Sales Person Restriction</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="domain_force">[('id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('baft_salesperson_rule.group_restricted_salesperson'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--Sale Order - Admin Rule-->
    <record id="sale_order_rule_admin" model="ir.rule">
        <field name="name">Sale Order: Admin</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
    </record>

    <!--Sale Order - Sales Person User Rule-->
    <record id="sale_order_rule_salesperson" model="ir.rule">
        <field name="name">Sale Order: Sales Person Restriction</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('baft_salesperson_rule.group_restricted_salesperson'))]"/>
    </record>

    <!--Product - Admin User Rule-->
    <record id="product_rule_admin" model="ir.rule">
        <field name="name">Product: Admin Restriction</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
    </record>

    <!--Product - Sales Person User Rule-->
    <record id="product_rule_salesperson" model="ir.rule">
        <field name="name">Product: Sales Person Restriction</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="domain_force">['|',('responsible_id', '=', user.id),('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('baft_salesperson_rule.group_restricted_salesperson'))]"/>
    </record>

    <!--Product - Admin User Rule-->
    <record id="product_template_rule_admin" model="ir.rule">
        <field name="name">Product Template: Admin Restriction</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
    </record>

    <!--Product - Sales Person User Rule-->
    <record id="product_template_rule_salesperson" model="ir.rule">
        <field name="name">Product Template: Sales Person Restriction</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="domain_force">['|',('responsible_id', '=', user.id),('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('baft_salesperson_rule.group_restricted_salesperson'))]"/>
    </record>

    <!-- Contact - Admin Rule -->
    <record id="res_partner_rule_admin" model="ir.rule">
        <field name="name">Contact: Admin Restriction</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
    </record>

    <!-- Contact - Sale Person Rule -->
    <record id="res_partner_rule_salesperson" model="ir.rule">
        <field name="name">Contact: Sales Person Restriction</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('baft_salesperson_rule.group_restricted_salesperson'))]"/>
    </record>

    <!-- Purchase Order - Admin Rule -->
    <record id="purchase_order_rule_admin" model="ir.rule">
        <field name="name">Purchase Order: Admin Restriction</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
    </record>

    <!-- Purchase Order - Sale Person Rule -->
    <record id="purchase_order_rule_sales_person" model="ir.rule">
        <field name="name">Purchase Order: Sales Person Restriction</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('baft_salesperson_rule.group_restricted_salesperson'))]"/>
    </record>

    <!-- Invoice - Admin Rule -->
    <record id="invoice_rule_admin" model="ir.rule">
        <field name="name">Invoice: Admin Restriction</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
    </record>

    <!-- Invoice - Sale Person Rule -->
    <record id="invoice_rule_sales_person" model="ir.rule">
        <field name="name">Invoice: Sales Person Restriction</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">['&amp;',('invoice_user_id', '=', user.id),('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('baft_salesperson_rule.group_restricted_salesperson'))]"/>
    </record>

    <!-- Contact - Inherit exist user Rule -->
    <function name="write" model="ir.model.data">
        <function name="search" model="ir.model.data">
            <value eval="[('module', '=', 'base'), ('name','=','res_partner_rule_private_employee')]"/>
        </function>
        <value eval=" {'noupdate': False} "/>
    </function>

    <record id="base.res_partner_rule_private_employee" model="ir.rule">
        <field name="domain_force">
            ['|','&amp;',('type', '!=', 'private'),('type', '=', False),('user_id', '=', user.id)]
        </field>
    </record>

    <function name="write" model="ir.model.data">
        <function name="search" model="ir.model.data">
            <value eval="[('module', '=', 'base'), ('name','=','res_partner_rule_private_employee')]"/>
        </function>
        <value eval=" {'noupdate': True} "/>
    </function>
</odoo>