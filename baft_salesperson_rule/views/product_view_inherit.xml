<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_product_tree_view_inherit" model="ir.ui.view">
        <field name="name">product.product.tree.inherit.sales.person</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tmpl_id']" position="after">
                <field name="responsible_id"/>
            </xpath>
        </field>
    </record>

    <record id="product_product_tree_view_inherit" model="ir.ui.view">
        <field name="name">product.product.tree.inherit.sales.person</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tmpl_id']" position="after">
                <field name="responsible_id"/>
            </xpath>
        </field>
    </record>

    <record id="product_normal_form_view_inherit" model="ir.ui.view">
        <field name="name">product.product.form.inherit.sales.person</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="responsible_id"/>
            </xpath>
        </field>
    </record>

    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(4, ref('account.group_account_readonly')), (4, ref('account.group_account_invoice')), (4, ref('baft_salesperson_rule.group_restricted_salesperson'))]"/>
    </record>
</odoo>