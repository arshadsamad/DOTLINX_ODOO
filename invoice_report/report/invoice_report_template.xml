<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<!--Custom layout for Invoice Report-->
	<template id="external_layout_invoice_report">
		<style>
			* {
				font-family: "Times New Roman", Times, serif;
			}
		</style>		
		<t t-if="not o" t-set="o" t-value="doc"/>
		<t t-if="not company">
			<!-- Multicompany -->
			<t t-if="company_id">
				<t t-set="company" t-value="company_id"/></t>
			<t t-elif="o and 'company_id' in o">
				<t t-set="company" t-value="o.company_id.sudo()"/></t>
			<t t-else="else">
				<t t-set="company" t-value="res_company"/></t>
		</t>
		<t t-call="invoice_report.external_layout_standard_custom_invoice">
			<t t-out="0"/></t>
	</template>
	
	<template id="external_layout_standard_custom_invoice">
		<style>
			* {
				font-family: "Times New Roman", Times, serif;
			}
		</style>
		<div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
			<div class="row">
				<div class="col-6" style="text-align:left;">
					<h1 style="color:#3f6ab0;">Company Name</h1>
				</div>
				<div class="col-6" style="text-align:right;">
					<h1 style="color:#85a7de;">
						<b>INVOICE</b>
					</h1>
				</div>
			</div>
			<div class="row" style="padding-top:20px;">
				<div class="col-6">
					<span t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;,&quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}"/>
				</div>
				<div class="col-6">
					
				</div>
			</div>
			<!-- code for degree in header -->
			<div class="row d-flex justify-content-between">
				<!--<div class="col-9"><div><strong class="h1-title">डॉ.&#160;शुभम शिंदे</strong></div><div>BAMS MD(Ayu)(Pune)</div><div>I-96574 A</div></div>-->
			</div>
		</div>
		<div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout"
			 t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
			 t-att-data-oe-lang="o and o.env.context.get('lang')">
			<t t-call="web.address_layout"/>
			<t t-out="0"/>
		</div>
		<div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">
			<t t-if="not o" t-set="o" t-value="doc"/>
			<div class="last-page  text-muted oe_mt8 oe_mb8" style="font-size:15px;">
				<div class="row" style="padding-top:50px;">
					<div class="col-4" style="text-align:center;">
						<p >OdooBot
							<br/>
							<strong style=" white-space: nowrap;">
						Prepared By Authorized Review By Customer</strong>
							<!-- <strong><t t-esc="o.scheduled_date"/></strong>     -->
						</p>
					</div>
					<div class="col-4" style="text-align:center;">
						<p>OdooBot
							<br/>
							<strong>Authorized</strong>
							<br/>
							<!-- <strong><t t-esc="o.scheduled_date"/></strong> -->
						</p>
					</div>
					<div class="col-4" style="text-align:center;">
						<p></p>
						<br/>
						<strong>Review By Customer</strong>
						<br/>
						<strong>(Name,Signature,Mobile)</strong>
					</div>
				</div>
			</div>
		</div>
	</template>

	<template id="report_invoice">
		<t t-call="web.html_container">
			<t t-foreach="docs" t-as="o">
				<!-- <t t-call="invoice_report.external_layout_invoice_report"> -->
				<t t-call="pways_purchase_consignment.external_header_qweb">
					<style>
						* {
							font-family: "Times New Roman", Times, serif;
						}
					</style>
					<div class="page">
						<div class="row" style="padding-top:15px;">
							<div class="col-6" style="text-align:left;">
							</div>
							<div class="col-6" style="text-align:right;">
						        <h1 style="color:#85a7de;">
						            <b>
						                <t t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</t>
						                <t t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</t>
						                <t t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</t>
						                <t t-if="o.move_type == 'out_refund'">Credit Note</t>
						                <t t-if="o.move_type == 'in_refund'">Vendor Credit Note</t>
						                <t t-if="o.move_type == 'in_invoice'">Vendor Bill</t>
						            </b>
						        </h1>
						    </div>
						</div>
						<div class="row" style="padding-top:5px;">
							<div class="col-6" style="text-align:left;">
								<table class="table table-borderless" height="60%" >
									<tr style="height:30px;">
										<td class="text-left" style="background-color:#1d3c6e;color:white;padding-top:10px;" width="5%">
											<b> BILL TO </b>
										</td>
									</tr>
									<tr style="height:30px;">
										<td class="text-left">
											<t t-esc="o.partner_id.name"/>
										</td>
									</tr>
									<tr style="height:30px;">
										<td class="text-left">
											<t t-esc="o.company_id.name"/>
										</td>
									</tr>
									<tr style="height:30px;">
										<td class="text-left">
											<span t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;,&quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}"/>
										</td>
									</tr>
								</table>
							</div>
							<div class="col-6">
								<div class="row">
									<div class="col-12">
										<table class="table table-borderless">
											<tr style="height:25px;">
												<td class="text-right" style="text-align: right;">
													DATE
												</td>
												<td style="border: 1px solid black;text-align: center;">
													<t t-if="o.invoice_date" t-esc="o.invoice_date.strftime('%d/%m/%Y')"/>
												</td>
											</tr>
											<tr style="height:25px;">
												<td class="text-right" style="text-align: right;">
													INVOICE #
												</td>
												<td style="border: 1px solid black;text-align: center;">
													<t t-esc="o.name"/>
												</td>
											</tr>
											<!-- <tr style="height:25px;">
												<td class="text-right" style="text-align: right;">
													CUSTOMER ID
												</td>
												<td style="border: 1px solid black;text-align: center;">
													123
												</td>
											</tr> -->
											<tr style="height:25px;">
												<td class="text-right" style="text-align: right;">
													DUE DATE
												</td>
												<td style="border: 1px solid black;background-color: #85a7de;min-width: 50px;text-align: center;">
													<t t-if="o.invoice_date_due" t-esc="o.invoice_date_due.strftime('%d/%m/%Y')"/>
												</td>
											</tr>
										</table>
									</div>
								</div>
							</div>
						</div>
						<div class="row">
							<table class="table table-borderless" style="font-family:Arial;margin-top:5px;margin-bottom: 5px;width:100%;margin:0;padding:0;margin-top:10px;border-bottom: 1px solid black;

								">
								<thead>
									<tr style="background-color:#C4B454;text-align: center;font-size: 14px;page-break-inside: avoid;">
										<th style="width:8%;height:10px;background-color:#1d3c6e;color:white;"><b> Sl.NO. </b> </th>
										<th style="width:40%;height:10px;background-color:#1d3c6e;color:white;"><b> DESCRIPTION </b> </th>
										<th style="width:8%;height:10px;background-color:#1d3c6e;color:white;"><b> QUANTITY </b> </th>
										<th style="width:12%;height:10px;background-color:#1d3c6e;color:white;"><b> UNIT PRICE </b> </th>
										<th style="width:12%;background-color:#1d3c6e;color:white;"> <b> VAT </b></th>
										<th style="width:15%;background-color:#1d3c6e;color:white;"> <b> AMOUNT </b> </th>
									</tr>
								</thead>
								<t t-set="count" t-value="0"/>
								<tbody style="border-bottom:1px black;">
									<t t-set="index" t-value="1"/>
									<t t-foreach="o.invoice_line_ids" t-as="line">
										<t t-set="range_line" t-value="15 - len(o.invoice_line_ids)"/>
										<t t-if="index % 2 == 0">
											<t t-set="background_color" t-value="'background-color: #e1e2e6;'"/>
										</t>
										<t t-else="">
											<t t-set="background_color" t-value="''"/>
										</t>
										<t t-set="index" t-value="index + 1"/>
										<tr t-att-style="'font-size:14px;page-break-inside: avoid;' + background_color" height="250%">
											<t t-set="count" t-value="count + 1"/>
											<td style="padding: 0.3rem 0.5rem;text-align: center;border-right:1px solid black;border-left:1px solid black;">
												<t t-esc="count"/>
											</td>
											<td style="padding: 0.3rem 0.5rem;text-align: center;border-right:1px solid black;border-left:1px solid black;">
												<t t-esc="line.product_id.name"/>
											</td>
											<td style="padding: 0.3rem 0.5rem;text-align: center;border-right:1px solid black;border-left:1px solid black;">
												<t t-esc="line.quantity"/>
											</td>
											<td style="padding: 0.3rem 0.5rem;border-right:1px solid black;text-align: center;border-left:1px solid black;">
												<t t-esc="'{:,.2f}'.format(line.price_unit)"/>
											</td>
											<td style="padding: 0.3rem 0.5rem;border-right:1px solid black;text-align: center;border-left:1px solid black;">
												<t t-esc="'{:,.2f}'.format(line.l10n_ae_vat_amount)"/>
											</td>
											<td style="padding: 0.3rem 0.5rem;border-right:1px solid black;text-align: center;border-left:1px solid black;">
												<t t-esc="'{:,.2f}'.format(line.price_total)"/>
											</td>
										</tr>
									</t>
									<t t-foreach="range(range_line)" t-as="l">
										<t t-if="index % 2 == 0">
											<t t-set="background_color" t-value="'background-color: #e1e2e6;'"/>
										</t>
										<t t-else="">
											<t t-set="background_color" t-value="''"/>
										</t>
										<t t-set="index" t-value="index + 1"/>
										<tr class="empty-row" t-att-style="'border-left:1px solid black;' + background_color">
											<td style="border-right:1px solid black;"></td>
											<td style="border-right:1px solid black;"></td>
											<td style="border-right:1px solid black;"></td>
											<td style="border-right:1px solid black;"></td>
											<td style="border-right:1px solid black;"></td>
											<td style="border-right:1px solid black;"></td>
										</tr>
									</t>
								</tbody>
							</table>
						</div>
						<div class="row" style="padding-top:50px;">
							<div class="col-7">
								<table class="table table-borderless" height="60%" >
									<tr style="height:30px;">
										<td class="text-left" style="background-color:#1d3c6e;color:white;padding-top:10px;"  width="5%">OTHER COMMENTS</td>
									</tr>
									<tr style="border:1px solid black;height:250px;" width="100%">
										<td>
											<span t-field="o.extra_notes"/>
										</td>
									</tr>
								</table>
							</div>
							<div class="col-1"/>
							<div class="col-4">
								<table class="table table-borderless" style="width: 100%;">
									<tr style="height:30px;">
										<td class="text-right" width="30%">
											Subtotal
										</td>
										<td style="text-align: right;">
											<t t-esc="'{:,.2f}'.format(o.amount_untaxed)"/>
										</td>
									</tr>
									<tr style="height:30px;">
										<td>
											Total Vat
										</td>
										<td style="text-align: right;">
											<t t-esc="'{:,.2f}'.format(o.amount_tax)"/>
										</td>
									</tr>
									
									<tr style="height:30px;border-top: 2px solid black;">
										<td>
											Total
										</td>
										<td style="text-align: right;">
											<t t-esc="'{:,.2f}'.format(o.amount_total)"/>
										</td>
									</tr>
								</table>
								<br/>
								<div>
									<span>Make all checks payable to</span><br/>
									<span style="font-size:14px;"><b><t t-esc="o.company_id.name"/></b></span>
								</div>
							</div>
						</div>
					</div>
					<div class="row" style="padding-top:50px;">
						<div class="col-12" style="text-align:center;">
							<!-- <p>If you have any questions about this invoice, please contact
								<br/>
								[
								<t t-esc="o.partner_id.name"/>,
								<t t-esc="o.partner_id.email"/>,
								<t t-esc="o.partner_id.phone"/>]
								<br/>
							</p> -->
							<span style="font-size:24px;">
								<b><i>Thank You For Your Business!</i></b>
							</span>
						</div>
					</div>
				</t>
			</t>
		</t>
	</template>
</odoo>