						table {
 						 	border-collapse: collapse;
						}

						* {
							font-family: "Times New Roman", Times, serif;
						}
					</style>
					<div class="page" style="border-left: 1px solid black;border-right: 1px solid black;border-bottom: 1px solid black;padding: 0px;">
						<!-- <div class="row"> -->
							<!-- <div class="col-9">
