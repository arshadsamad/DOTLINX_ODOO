<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="paperformat_delivery_report" model="report.paperformat">
		<field name="name">Delivery Report Paperformat</field>
		<field name="default" eval="True"/>
	  	<field name="format">A4</field>
	  	<field name="page_height">0</field>
	  	<field name="page_width">0</field>
	  	<field name="orientation">Portrait</field>
	  	<field name="margin_top">45</field>
	  	<field name="margin_bottom">30</field>
	  	<field name="margin_left">3</field>
	  	<field name="margin_right">3</field>
	  	<field name="header_line" eval="False"/>
	  	<field name="header_spacing">40</field>
	  	<field name="dpi">90</field>
	</record>

	<record id="action_report_delivery_order" model="ir.actions.report">
		<field name="name">Delivery Order Report</field>
		<field name="model">stock.picking</field>
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">delivery_report.report_delivery_order</field>
		<field name="report_file">delivery_report.report_delivery_order</field>
		<field name="binding_model_id" ref="stock.model_stock_picking"/>
		<field name="paperformat_id" ref="delivery_report.paperformat_delivery_report"/>
		<field name="binding_type">report</field>
	</record>

</odoo>