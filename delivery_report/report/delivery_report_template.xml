<?xml version="1.0" encoding="utf-8"?>
<odoo>
		
	<template id="external_layout_delivery_order_report">
		<style>
			* {
				font-family: "Times New Roman", Times, serif;
			}
		</style>		
		<t t-if="not o" t-set="o" t-value="doc"/>
		<t t-if="not company">
			<!-- Multicompany -->
			<t t-if="company_id">
				<t t-set="company" t-value="company_id"/></t>
			<t t-elif="o and 'company_id' in o">
				<t t-set="company" t-value="o.company_id.sudo()"/></t>
			<t t-else="else">
				<t t-set="company" t-value="res_company"/></t>
		</t>
		<t t-call="delivery_report.external_layout_standard_custom_delivery">
			<t t-raw="0"/></t>
	</template>
	
	<template id="external_layout_standard_custom_delivery">
		<style>
			* {
				font-family: "Times New Roman", Times, serif;
			}
		</style>		
		<div class="header">
         <div style="width: 100%; border-collapse: collapse; border: 1px solid black; border-radius: 10px; overflow: hidden;">
            <table style="width: 100%; border-spacing: 0;">
               <tr>
                  <td colspan="2" style="width: 80%; padding: 10px; text-align: left; vertical-align: middle;border-right:hidden;color:#35095e;font-size: 28px;">
                     <!-- <strong t-field="o.company_id.name" style="font-size: 24px;"></strong> -->
                     <strong><t t-esc="o.company_id.name"/></strong>
                  </td>
                  <td rowspan="3" style="width: 20%; padding: 2px; text-align: center; vertical-align: middle;border-left:hidden;">
                     <img t-if="o.company_id.logo"
										t-attf-src="data:image/png;base64, #{o.company_id.logo}"
										style="width: 100%;"
										alt="Logo" />
                  </td>
               </tr>
               <tr>
                  <td colspan="2" style="width: 80%; padding: 10px; text-align: left; vertical-align: middle;background-color:#00a197;border-right:hidden;border-bottom:hidden;border-top:hidden;color:#FFFFFF;font-size: 18px;">
                     <!-- <strong t-field="o.company_id.name" style="font-size: 18px;"></strong> -->
                     <!-- <strong>FOODSTUFF TRADING LLC</strong> -->
                  </td>
               </tr>
               <tr>
                  <td style="width: 40%; padding: 10px; text-align: left; vertical-align: middle;border-right:hidden;">
                     <!-- <strong t-field="o.company_id.name" style="font-size: 18px;"></strong><br/> -->
                     <span style="font-size: 14px;">
                        <t t-esc="o.company_id.street"/>
                        <t t-if="o.company_id.street2">
                           , 
                           <t t-esc="o.company_id.street2"/>
                        </t>
                        <br/>
                        <t t-esc="o.company_id.city"/>
                        , 
                        <t t-esc="o.company_id.state_id.name"/>
                        , 
                        <t t-esc="o.company_id.zip"/>
                        <br/>
                        <t t-esc="o.company_id.country_id.name"/>
                        <br/>
                     </span>
                  </td>
                  <td style="width: 40%; padding: 10px; text-align: right; vertical-align: middle;border-right:hidden;">
                     <span style="font-size: 14px;">
                        Tel: 
                        <t t-esc="o.company_id.phone"/>
                        <br/>
                        Website: 
                        <t t-esc="o.company_id.website"/>
                        <br/>
                        Email: 
                        <t t-esc="o.company_id.email"/>
                     </span>
                  </td>
               </tr>
            </table>
         </div>
      </div>
		<div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout"
			t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
			t-att-data-oe-lang="o and o.env.context.get('lang')">
			<t t-call="web.address_layout"/>
			<t t-raw="0"/>
		</div>
		<div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">
			<t t-if="not o" t-set="o" t-value="doc"/>
			<div class="last-page  text-muted oe_mt8 oe_mb8" style="font-size:15px;">
				<div class="row" style="padding-top:50px;">
					<div class="col-4" style="text-align:center;">
						<p ><span t-field="o.user_id.name"/>
							<br/>
							<strong style=" white-space: nowrap;">
							Prepared By</strong><br/>
							<strong>
								<t t-if="o.create_date" t-esc="o.create_date.strftime('%d/%m/%Y')"/>
							</strong>
						</p>
					</div>
					<div class="col-4" style="text-align:center;">
						<p><span t-field="o.user_id.name"/>
							<br/>
							<strong>Authorized</strong>
							<br/>
							<strong>
								<t t-if="o.create_date" t-esc="o.create_date.strftime('%d/%m/%Y')"/>
							</strong>
						</p>
					</div>
					<div class="col-4" style="text-align:center;">
						<p></p>
						<br/>
						<strong>Review By Customer</strong>
						<br/>
						<strong>(Name,Signature,Mobile)</strong>
					</div>
				</div>
			</div>
		</div>
	</template>

