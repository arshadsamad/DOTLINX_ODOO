<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="tree_expenses_config_view" model="ir.ui.view">
		<field name="name">expenses.config.tree</field>
		<field name="model">expenses.config</field>
		<field name="arch" type="xml">
			<tree editable="bottom" string="Expenses">
				<field name="name"/>
				<field name="is_commission_expense"/>
				<field name="commission_percent" attrs="{'readonly':[('is_commission_expense', '=', False)]}"/>
			</tree>
		</field>
	</record>

	<record id="action_expenses_config" model="ir.actions.act_window">
		<field name="name">Expenses</field>
		<field name="res_model">expenses.config</field>
		<field name="view_mode">tree</field>
	</record>

	<menuitem id="menu_expenses_config" name="Expenses" action="action_expenses_config" parent="pways_purchase_consignment.menu_consignments_configuraiton" sequence="1"/>
</odoo>
