<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
       <record id="view_sale_order_form_inherit_consignments" model="ir.ui.view">
            <field name="name">sale.order.view</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <field name="date_order" position="after">
                    <field name="is_consignments_purchase" invisible="1"/>
                    <field name="is_consignments" attrs="{'invisible': [('is_consignments_purchase', '=', False)]}"/>
                   <!-- <field name="analytic_id"  attrs="{'invisible': [('is_consignments', '=', False)], 'required': [('is_consignments','=', True)]}" domain="[('is_consignments', '=', True)]"/>-->
                </field>
                <xpath expr="//page/field[@name='order_line']/tree/field[@name='product_id']" position="after">

                    <field name="purchase_order_line_id" force_save="1" readonly="1" attrs="{'column_invisible': [('parent.is_consignments', '=', False)]}" invisible='1'/>
                </xpath>
                
                
                <xpath expr="//page/field[@name='order_line']/tree/field[@name='name']" position="before">
                    <field name="analytic_id" attrs="{'column_invisible': [('parent.is_consignments', '=', False)], 'required': [('parent.is_consignments','=', True)]}" domain="[('is_consignments', '=', True)]"/>
                    <field name="consignment_product_ids" invisible="1" widget="many2many_tags"/>
                    <field name="consignment_lot_id" invisible="1"/>
                    <field name="consignment_product_id" attrs="{'column_invisible': [('parent.is_consignments', '=', False)]}" domain="[('id', 'in', consignment_product_ids)]" options="{'no_create':True, 'no_create_edit':True}"/>
                </xpath>

                <xpath expr="//page/field[@name='order_line']/tree/field[@name='product_id']" position="attributes">
                    <!--<attribute name="domain">[('id', 'in', consignment_product_ids)]</attribute>-->
                    <attribute name="attrs">{'column_invisible': [('parent.is_consignments', '=', True)]}</attribute>
                    <attribute name="options">{'no_create':True, 'no_create_edit':True}</attribute>
                </xpath>



                
<!--                <xpath expr="//page/field[@name='order_line']/tree/field[@name='product_id']" position="replace">-->
<!--                    <field name="product_id"-->
<!--                        domain="[('sale_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id), ('is_consignments', '=', parent.is_consignments_purchase)]"-->
<!--                        context="{'partner_id':parent.partner_id, 'quantity':product_uom_qty, 'pricelist':parent.pricelist_id, 'uom':product_uom, 'company_id': parent.company_id}"-->
<!--                        attrs="{-->
<!--                            'readonly': [('product_updatable', '=', False)],-->
<!--                            'required': [('display_type', '=', False)],-->
<!--                        }"-->
<!--                        force_save="1"-->
<!--                        widget="many2one_barcode"/>-->
<!--                </xpath>-->
            </field>
        </record>

        <record id="sale_product_configurator.sale_order_view_form" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.sale.product.configurator</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <field name="date_order" position="after">
                    <field name="is_consignments_purchase" invisible="1"/>
                </field>
                <!--<xpath expr="//tree/field[@name='product_template_id']" position="attributes">
                    <attribute name="invisible">0</attribute>
                </xpath>
                <xpath expr="//tree/field[@name='product_template_id']" position="after">
                    <field name="product_template_attribute_value_ids" invisible="1" />
                    <field name="product_custom_attribute_value_ids" invisible="1" >
                        <tree>
                            <field name="custom_product_template_attribute_value_id" />
                            <field name="custom_value" />
                        </tree>
                    </field>
                    <field name="product_no_variant_attribute_value_ids" invisible="1" />
                    <field name="is_configurable_product" invisible="1" />
                </xpath>
                <xpath expr="//tree/field[@name='product_id']" position="attributes">
                    <attribute name="optional">hide</attribute>
                    <attribute name="string">Product Variant</attribute>
                </xpath>-->
            </field>
        </record>

        <record id="action_consignments_orders" model="ir.actions.act_window">
            <field name="name">Sale Orders</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('is_consignments', '=', True)]</field>
            <field name="context">{'default_is_consignments': 1, 'default_is_consignments_purchase': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face"> Create Sale Orders </p>
            </field>
        </record>

        <menuitem id="menu_consignments_orders" 
            name="Consignments Sale Orders"
            action="action_consignments_orders"
            parent="pways_purchase_consignment.menu_main_consignments"
            sequence="2"/>

    </data>
</odoo>
