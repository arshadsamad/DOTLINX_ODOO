<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="consignment_status_report_wizard_view" model="ir.ui.view">
        <field name="name">Consignment Status Report Wizard</field>
        <field name="model">consignment.status.report.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Consignment Status Report">
                <group>
                    <field name="consignment_account_ids" domain="[('is_consignments', '=', True)]" widget="many2many_tags"/>
                </group>
                <footer>
                    <button class="oe_highlight" name="action_print_report" string="Print" type="object"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_consignment_status_report_wizard" model="ir.actions.act_window">
        <field name="name">Consignment Status Report Wizard</field>
        <field name="res_model">consignment.status.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record> 

     <menuitem id="menu_consignment_status_report" action="action_consignment_status_report_wizard"
               name="Consignments Status Report" sequence="25" parent="pways_purchase_consignment.menu_main_reporting"/>
</odoo>
