		<record model="ir.actions.report" id="action_consignment_detail_report_xlsx">
			<field name="name">Consignment Detail Report Xlsx</field>
			<field name="model">account.analytic.account</field>
			<field name="report_type">xlsx</field>
			<field name="binding_model_id" ref="model_account_analytic_account" />
			<field name="print_report_name">'Consignment Detail Report '</field>
			<field name="report_name">consignment.consignment_detail_report_xlsx</field>
			<field name="report_file">consignment.consignment_detail_report_xlsx</field>
			<field name="binding_type">report</field>
		</record>


		<record id="report_paperformat_action_consignment_detail"
		  model="report.paperformat">
		  <field name="name">Consignment Detail Report Format</field>
		  <field name="default" eval="True"/>
		  <field name="format">A4</field>
		  <field name="page_height">0</field>
		  <field name="page_width">0</field>
		  <field name="orientation">Portrait</field>
		  <field name="margin_top">55</field>
		  <field name="margin_bottom">3</field>
		  <field name="margin_left">3</field>
		  <field name="margin_right">3</field>
		  <field name="header_line" eval="False"/>
		  <field name="header_spacing">50</field>
		  <field name="dpi">90</field>
	   </record>
	   <record id="action_consignment_detail_report_pdf" model="ir.actions.report">
		  <field name="name">Consignment Detail Report PDF</field>
		  <field name="model">account.analytic.account</field>
		  <field name="report_type">qweb-pdf</field>
		  <field name="report_name">pways_purchase_consignment.consignment_detail_report_pdf</field>
		  <field name="report_file">pways_purchase_consignment.consignment_detail_report_pdf</field>
		  <field name="print_report_name">'Consignment_Detail_Report '+ (object.name)</field>
		  <field name="paperformat_id" ref="pways_purchase_consignment.report_paperformat_action_consignment_detail" />
		  <field name="binding_model_id" ref="model_account_analytic_account" />
		  <field name="binding_type">report</field>
	   </record>


	</data>
</odoo>