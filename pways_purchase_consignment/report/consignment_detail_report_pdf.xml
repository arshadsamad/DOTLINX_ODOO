<?xml version="1.0" encoding="utf-8"?>
<odoo>

   <template id="external_header_qweb">
      <div class="header">
         <div style="width: 100%; border-collapse: collapse; border: 1px solid black; border-radius: 10px; overflow: hidden;">
            <table style="width: 100%; border-spacing: 0;">
               <tr>
                  <td colspan="2" style="width: 80%; padding: 10px; text-align: left; vertical-align: middle;border-right:hidden;color:#35095e;font-size: 28px;">
                     <!-- <strong t-field="o.company_id.name" style="font-size: 24px;"></strong> -->
                     <strong><t t-esc="o.company_id.name"/></strong>
                  </td>
                  <td rowspan="3" style="width: 20%; padding: 2px; text-align: center; vertical-align: middle;border-left:hidden;">
                     <img t-if="o.company_id.logo"
										t-attf-src="data:image/png;base64, #{o.company_id.logo}"
										style="width: 100%;"
										alt="Logo" />
                  </td>
               </tr>
               <tr>
                  <td colspan="2" style="width: 80%; padding: 10px; text-align: left; vertical-align: middle;background-color:#00a197;border-right:hidden;border-bottom:hidden;border-top:hidden;color:#FFFFFF;font-size: 18px;">
                     <!-- <strong t-field="o.company_id.name" style="font-size: 18px;"></strong> -->
                     <strong>FOODSTUFF TRADING LLC</strong>
                  </td>
               </tr>
               <tr>
                  <td style="width: 40%; padding: 10px; text-align: left; vertical-align: middle;border-right:hidden;">
                     <!-- <strong t-field="o.company_id.name" style="font-size: 18px;"></strong><br/> -->
                     <span style="font-size: 14px;">
                        <t t-esc="o.company_id.street"/>
                        <t t-if="o.company_id.street2">
                           , 
                           <t t-esc="o.company_id.street2"/>
                        </t>
                        <br/>
                        <t t-esc="o.company_id.city"/>
                        , 
                        <t t-esc="o.company_id.state_id.name"/>
                        , 
                        <t t-esc="o.company_id.zip"/>
                        <br/>
                        <t t-esc="o.company_id.country_id.name"/>
                        <br/>
                     </span>
                  </td>
                  <td style="width: 40%; padding: 10px; text-align: right; vertical-align: middle;border-right:hidden;">
                     <span style="font-size: 14px;">
                        Tel: 
                        <t t-esc="o.company_id.phone"/>
                        <br/>
                        Website: 
                        <t t-esc="o.company_id.website"/>
                        <br/>
                        Email: 
                        <t t-esc="o.company_id.email"/>
                     </span>
                  </td>
               </tr>
            </table>
         </div>
      </div>
      <div t-attf-class="article" t-att-data-oe-model="o and o._name"
         t-att-data-oe-id="o and o.id"
         t-att-data-oe-lang="o and o.env.context.get('lang')">
         <t t-call="web.address_layout" />
         <t t-raw="0" />
      </div>
   </template>
   <template id="consignment_detail_report_pdf">
      <t t-call="web.html_container">


         <t t-foreach="docs" t-as="o">
             <style>
            td {
               padding-left: 2px;
            }
         </style>
            <t t-call="pways_purchase_consignment.external_header_qweb">
               <h3 style="text-align: center; margin-top: 10px; font-size: 24px;">
                  <b> CONSIGNMENT DETAILED REPORT </b>
               </h3>
               <br/>
               <br/>
               <div class="content">
                  <table style="width: 100%; border-collapse: collapse; margin-top: 20px; border: 1px solid black;">
                     <tr>
                        <td style="border: 1px solid black; padding: 8px; font-weight: bold; width: 25%;">Date</td>
                        <td style="border: 1px solid black; padding: 8px; width: 25%;"><t t-esc="o.purchase_order_id.date_approve"/></td>
                        <td style="border: 1px solid black; padding: 8px; font-weight: bold; width: 25%;">Parking Date</td>
                        <td style="border: 1px solid black; padding: 8px; width: 25%;"><t t-esc="o.purchase_order_id.parking_date"/></td>
                     </tr>
                     <tr>
                        <td style="border: 1px solid black; padding: 8px; font-weight: bold;">Items</td>
                        <td style="border: 1px solid black; padding: 8px;"><t t-esc="o.purchase_order_id.items_details"/></td>
                        <td style="border: 1px solid black; padding: 8px; font-weight: bold;">Release Date</td>
                        <td style="border: 1px solid black; padding: 8px;"><t t-esc="o.purchase_order_id.release_date"/></td>
                     </tr>
                     <tr>
                        <td style="border: 1px solid black; padding: 8px; font-weight: bold;">Vessel Name</td>
                        <td style="border: 1px solid black; padding: 8px;"><t t-esc="o.purchase_order_id.vessel_name"/></td>
                        <td style="border: 1px solid black; padding: 8px; font-weight: bold;">Landed Date</td>
                        <td style="border: 1px solid black; padding: 8px;"><t t-esc="o.purchase_order_id.landed_date"/></td>
                     </tr>
                     <tr>
                        <td style="border: 1px solid black; padding: 8px; font-weight: bold;">Container Qty</td>
                        <td style="border: 1px solid black; padding: 8px;"><t t-esc="o.purchase_order_id.container_qty"/></td>
                        <td style="border: 1px solid black; padding: 8px; font-weight: bold;">Container No</td>
                        <td style="border: 1px solid black; padding: 8px;"><t t-esc="o.purchase_order_id.consign_container_no"/></td>
                     </tr>
                  </table>
               </div>
               <br/>
               <br/>

               <!--PO Lines-->
               <t t-foreach="o.get_product_so_lines()" t-as="line">

                  <t t-foreach="line['data_wise']" t-as="product">
                    <t style="page-break-inside: avoid;">
                  <strong> <t t-esc="product['product_header_name']"/></strong> <br/>
                  <div style="width: 100%; border-collapse: collapse; border: 1px solid black; border-radius: 10px; overflow: hidden;">
                     <table style="width: 100%; border-spacing: 0;" >
                        <thead style="background: lightgrey;">
                           <tr>
                              <th style="border: 1px solid black; padding: 8px; text-align: center;">S.No</th>
                              <th style="border: 1px solid black; padding: 8px; text-align: center;">Sold Qty</th>
                              <th style="border: 1px solid black; padding: 8px; text-align: center;">Remaining Qty</th>
                              <th style="border: 1px solid black; padding: 8px; text-align: center;">Selling Price(AED)</th>
                              <th style="border: 1px solid black; padding: 8px; text-align: center;">Total Sold Value(AED)</th>
                              <th style="border: 1px solid black; padding: 8px; text-align: center;">Sold By</th>
                           </tr>
                        </thead>
                        <tbody>
                           <t t-set="serial_no" t-value="1"/>
                           <tr t-foreach="product['so_data_list']" t-as="so_data">
                                 <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                     <t t-esc="serial_no"/>
                                 </td>
                                 <td style="border: 1px solid black; padding: 8px; text-align: right;">
                                     <t t-esc="so_data['sold_qty']" t-options='{"widget": "float", "precision": 1}'/>
                                 </td>
                                 <td style="border: 1px solid black; padding: 8px; text-align: right;">
                                     <t t-esc="so_data['remaining_qty']" t-options='{"widget": "float", "precision": 1}'/>
                                 </td>
                                 <td style="border: 1px solid black; padding: 8px; text-align: right;">
                                     <t t-esc="so_data['selling_price']" t-options='{"widget": "float", "precision": 1}'/>
                                 </td>
                                 <td style="border: 1px solid black; padding: 8px; text-align: right;">
                                     <t t-esc="so_data['total_sold_value']" t-options='{"widget": "float", "precision": 1}'/>
                                 </td>
                                 <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                     <t t-esc="so_data['sold_by']"/>
                                 </td>
                           <t t-set="serial_no" t-value="serial_no + 1"/>
                           </tr>

                           <tr>
                                 <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                    <strong>Total</strong>
                                 </td>
                                 <td style="border: 1px solid black; padding: 8px; text-align: right;">
                                    <strong><t t-esc="product['total_sold_qty_product']" t-options='{"widget": "float", "precision": 1}'/></strong>
                                 </td>
                                 <td style="border: 1px solid black; padding: 8px; text-align: right;">
                                    <strong><t t-esc="product['total_remaining_qty_product']" t-options='{"widget": "float", "precision": 1}'/></strong>
                                 </td>
                                 <td style="border: 1px solid black; padding: 8px; text-align: right;">
                                 </td>
                                 <td style="border: 1px solid black; padding: 8px; text-align: right;">
                                    <strong><t t-esc="product['total_sold_value_product']" t-options='{"widget": "float", "precision": 1}'/></strong>
                                 </td>
                                 <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                 </td>

                           </tr>

                        </tbody>
                     </table>
                  </div>
                        <br/><br/><br/>
                    </t>
               </t>

               <div style="width: 100%; border-collapse: collapse; border: 1px solid black; border-radius: 10px; overflow: hidden;">
                     <table style="width: 100%; border-spacing: 0;">
                        <thead style="background: lightgrey;">
                           <tr>
                              <th style="border: 1px solid black; padding: 8px; text-align: center;">Item</th>
                              <th style="border: 1px solid black; padding: 8px; text-align: center;">Total Sold Value(AED)</th>
                              <th style="border: 1px solid black; padding: 8px; text-align: center;">Description</th>
                              <th style="border: 1px solid black; padding: 8px; text-align: center;">Amount(AED)</th>
                           </tr>
                        </thead>
                        <tbody>
                           <tr t-foreach="line['pro_exp_data_list']" t-as="pro_exp">
                                 <td style="border: 1px solid black; padding: 8px; text-align: left;">
                                     <t t-esc="pro_exp['product_name']"/>
                                 </td>
                                 <td style="border: 1px solid black; padding: 8px; text-align: right;">
                                     <t t-esc="pro_exp['total_sold_value_product']" t-options='{"widget": "float", "precision": 1}'/>
                                 </td>
                                 <td style="border: 1px solid black; padding: 8px; text-align: left;">
                                     <t t-esc="pro_exp['expense_name']"/>
                                 </td>
                                 <td style="border: 1px solid black; padding: 8px; text-align: right;">
                                     <t t-esc="pro_exp['amount']" t-options='{"widget": "float", "precision": 1}'/>
                                 </td>
                           </tr>
                        </tbody>

                        <tr>
                            <td style="padding: 8px; "><strong>Total Sales</strong></td><td style="padding: 8px; text-align: right;"><strong><t t-esc="line['total_sales_amt']" t-options='{"widget": "float", "precision": 1}'/></strong></td><td></td><td></td>
                        </tr>
                        <tr><td style="padding: 8px; "><strong>Net Amount</strong></td><td style="padding: 8px; text-align: right;"><strong><t t-esc="line['net_amount']" t-options='{"widget": "float", "precision": 1}'/></strong></td><td style="padding: 8px; "><strong>Net Payable</strong></td><td style="padding: 8px; text-align: right;"><strong><t t-esc="line['net_payable_amt']" t-options='{"widget": "float", "precision": 1}'/></strong></td></tr>
                     </table>
               </div>

               </t>
            </t>
         </t>
      </t>
   </template>
</odoo>